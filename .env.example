# Copia este archivo como .env y rellena los valores.
ENV=development
LOG_LEVEL=INFO
# LOG_DIR=logs

# --- Rutas (obligatorias) ---------------------------------------------------
# Carpeta vigilada. Se crean dentro: manual_review/ y duplicates/
# INBOX_PATH={$HOME}/Documents/Academic/00-Papers/_Inbox
INBOX_PATH=
# Destino de los PDFs renombrados. Debe existir en la máquina donde corre Zotero
# (el PDF se enlaza por ruta absoluta, no se sube a Zotero).
ARCHIVE_PATH=
# Opcional: base SQLite de estado (por defecto ARCHIVE_PATH/.biblio_demon.sqlite3)
STATE_DB_PATH=
LOG_DIR=

# --- Metadatos ---------------------------------------------------------------
# Email de contacto para el "polite pool" de Crossref (obligatorio)
CROSSREF_EMAIL=name@mail.com
# Opcional: sube el límite de peticiones de Semantic Scholar
# SEMANTIC_SCHOLAR_API_KEY=
# Comprobar que el título de la API aparece en la portada del PDF
VERIFY_TITLE=true
TITLE_MATCH_THRESHOLD=80
# HTTP_TIMEOUT=20
# HTTP_MAX_ATTEMPTS=5
# MAX_DOI_CANDIDATES=5

# --- Nombre de archivo -----------------------------------------------------
FILENAME_TITLE_WORDS=6
DROP_LEADING_STOPWORDS=true
FILENAME_WORD_SEPARATOR=-
# --- Watcher -------------------------------------------------------------------
# El archivo debe mantener tamaño y mtime durante STABLE_CHECKS sondeos
STABLE_CHECKS=3
STABLE_INTERVAL=1.0

# --- Zotero (opcional: sin credenciales se omite) -----------------------------
# userID numérico: https://www.zotero.org/settings/keys ("Your userID for use in API calls")
ZOTERO_USER_ID=
# Crear en https://www.zotero.org/settings/keys/new con "Allow write access"
ZOTERO_API_KEY=
ZOTERO_LIBRARY_TYPE=user
# Opcional: clave de 8 caracteres de una colección destino (aparece en su URL)
ZOTERO_COLLECTION_KEY=
ZOTERO_ATTACH_PDF=false
# --- Notion (opcional: sin credenciales se omite) -----------------------------
# Token de una integración interna: https://www.notion.so/profile/integrations
# (luego, en la base de datos: ••• → Conexiones → añadir la integración)
NOTION_TOKEN=
# ID de 32 caracteres de la URL de la base de datos
NOTION_DATABASE_ID=

# Nombres de las propiedades (deben existir con estos tipos):
# Title
NOTION_PROP_TITLE=Name
# URL
NOTION_PROP_DOI=DOI
# Number
NOTION_PROP_YEAR=Año
# Status
NOTION_PROP_STATUS=Estado
# Text
NOTION_PROP_AUTHORS=Autores
NOTION_STATUS_VALUE=Inbox
# Opcionales (deja vacío para desactivar):
# Select
NOTION_PROP_VENUE=Revista
# Number
NOTION_PROP_CITATIONS=Citas
# Multi-select
NOTION_PROP_SUBJECTS=Áreas

